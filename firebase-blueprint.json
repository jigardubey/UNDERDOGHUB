{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "bgmiId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "eSports Tournament listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "game": { "type": "string" },
        "type": { "type": "string" },
        "prizePool": { "type": "string" },
        "entryFee": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "organizer": { "type": "string" },
        "organizerUid": { "type": "string" },
        "maxSlots": { "type": "integer" },
        "slotsFilled": { "type": "integer" },
        "isVerified": { "type": "boolean" },
        "status": { "type": "string" },
        "format": { "type": "string" },
        "map": { "type": "string" },
        "rules": { "type": "string" },
        "isPendingApproval": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "game", "prizePool", "organizer"]
    },
    "CustomMatch": {
      "title": "Custom Match",
      "description": "User custom match room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userUid": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "roomCode": { "type": "string" },
        "password": { "type": "string" },
        "map": { "type": "string" },
        "notes": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "VerificationRequest": {
      "title": "Verification Request",
      "description": "Organizer badge verification request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "applicantUid": { "type": "string" },
        "organizerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "feePaid": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "organizerName"]
    },
    "UserSchedule": {
      "title": "User Saved Schedule",
      "description": "Saved tournament IDs for user",
      "type": "object",
      "properties": {
        "savedIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
